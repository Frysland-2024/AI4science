      "literature_source": "Schopmans et al. 2023",
      "code_source": "src/xrd_robustness/measurement_models.py",
      "physics_basis": "Positive correlation length enforces a slowly varying background; source units are not treated as directly interchangeable."
    },
    "background_floor_fraction": {
      "code_source": "src/xrd_robustness/measurement_models.py",
      "physics_basis": "A bounded non-negative floor represents continuous background intensity before observation noise."
    },
