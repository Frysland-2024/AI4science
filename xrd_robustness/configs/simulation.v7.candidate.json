      "code_source": "src/xrd_robustness/measurement_models.py",
      "physics_basis": "Photon counts follow a Poisson process and electronic readout is approximated by additive Gaussian noise."
    },
    "noise_stage": {
      "code_source": "src/xrd_robustness/measurement_models.py",
      "physics_basis": "Observation noise is sampled on expected intensity before clipping and model-input normalization."
    },
    "poisson_count_scale": {
      "code_source": "src/xrd_robustness/measurement_models.py",
      "physics_basis": "The positive count scale is the exposure/intensity factor in C_i ~ Poisson(g I_i); candidate bounds require dev_3500 review."
    },
    "electronic_noise_std_ratio": {
      "code_source": "src/xrd_robustness/measurement_models.py",
      "physics_basis": "Non-negative Gaussian readout-noise scale relative to expected intensity; retained at zero for count-space V7 profiles."
    },
    "electronic_noise_std_counts": {
      "code_source": "src/xrd_robustness/measurement_models.py",
