{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.xrd-robustness/schemas/algorithm.v8.independent_dynamic_erm.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "algorithm_name",
    "status",
    "training_mode",
    "views_per_structure_per_step",
    "training_objective",
    "perturbation_strategy",
    "marginal_profile_source",
    "generation_order",
    "forbidden_relations",
    "formal_training_allowed",
    "formal_training_blocker"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "v8.0-independent-erm"},
    "algorithm_name": {"const": "independent_dynamic_erm"},
    "status": {"const": "software_ready_scientific_ranges_candidate"},
    "training_mode": {"const": "dynamic_erm"},
    "views_per_structure_per_step": {"const": 2},
    "training_objective": {"const": "mean_cross_entropy_over_two_views"},
    "perturbation_strategy": {
      "type": "object",
      "required": ["name", "sampling_distribution", "shared_measurement_state", "online_resampling", "operator_names"],
      "properties": {
        "name": {"const": "independent_dynamic"},
        "sampling_distribution": {"const": "product_of_operator_marginals"},
        "shared_measurement_state": {"const": false},
        "online_resampling": {"const": true},
        "operator_names": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {"enum": ["zero_shift", "peak_broadening", "preferred_orientation", "background", "noise"]}
        }
      },
      "additionalProperties": false
    },
    "marginal_profile_source": {
      "type": "object",
      "required": ["path", "profile", "sha256", "inheritance_rule"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "profile": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
        "inheritance_rule": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "generation_order": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "string"}},
    "forbidden_relations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "formal_training_allowed": {"const": false},
    "formal_training_blocker": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
