{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v9_prediction_rows.schema.json",
  "title": "V9 per-spectrum prediction row",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "seed",
    "method_id",
    "profile",
    "material_id",
    "family_id",
    "label",
    "prediction",
    "probabilities"
  ],
  "properties": {
    "seed": {"type": "integer"},
    "method_id": {"type": "string", "minLength": 1},
    "profile": {"type": "string", "minLength": 1},
    "material_id": {"type": "string", "minLength": 1},
    "family_id": {"type": "string", "minLength": 1},
    "label": {"type": "integer", "minimum": 0},
    "prediction": {"type": "integer", "minimum": 0},
    "probabilities": {
      "type": "array",
      "minItems": 2,
      "items": {"type": "number", "minimum": 0.0, "maximum": 1.0}
    },
    "second_probabilities": {
      "type": "array",
      "minItems": 2,
      "items": {"type": "number", "minimum": 0.0, "maximum": 1.0}
    }
  }
}
