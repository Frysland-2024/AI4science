  },
  "deliberately_disabled_until_target_gate": {},
  "desktop_measurement_gate": {
    "no_training": true,
    "prefetch_worker_candidates": [4, 6, 8, 10],
    "prefetch_batch_candidates": [6, 8, 10],
    "evaluation_batch_candidates": [128, 256, 512],
    "required_checks": [
      "exact_parameter_pair_hash",
      "exact_spectrum_array_equivalence",
      "quality_gate_count_equivalence",
      "full_prefetch_candidate_matrix_pass",
      "evaluation_batch_candidate_gate_pass",
      "no_cuda_out_of_memory",
      "pinned_non_blocking_h2d_pass",
      "bf16_forward_backward_numerical_equivalence",
      "torch_compile_eager_numerical_equivalence",
      "compile_fallback_smoke_pass",
      "torch_compile_graph_executed",
      "two_run_peak_vram_below_15360_mb",
      "two_run_aggregate_throughput_not_lower_than_serial",
      "effective_parallel_worker_budget_is_eight",
      "target_gpu_name_and_memory_match",
      "pip_check_pass"
