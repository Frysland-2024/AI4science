      "hardware_audit": "scripts/audit_v9_desktop_hardware_config.py",
      "prefetch_matrix_audit": "scripts/audit_v9_prefetch_matrix.py",
      "evaluation_batch_audit": "scripts/audit_v9_evaluation_batch.py",
