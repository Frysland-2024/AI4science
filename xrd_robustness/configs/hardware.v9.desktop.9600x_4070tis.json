    "cuda_math": {
      "float32_matmul_precision": "high",
      "allow_tf32_matmul": true,
      "allow_tf32_cudnn": true,
      "cudnn_benchmark": true,
      "cudnn_deterministic": true
    },
    "optimizer": {
      "name": "AdamW",
      "fused": true,
      "zero_grad_set_to_none": true
    },
    "automatic_mixed_precision": {
