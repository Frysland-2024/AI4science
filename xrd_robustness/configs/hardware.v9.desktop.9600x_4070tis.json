{
  "schema_version": "v9-desktop-hardware-profile-v1",
  "status": "target_configuration_pending_desktop_measurement",
  "target": {
    "cpu": "AMD Ryzen 5 9600X",
    "physical_cores": 6,
    "logical_threads": 12,
    "gpu": "NVIDIA GeForce RTX 4070 Ti SUPER",
    "gpu_memory_mb": 16384,
    "minimum_system_memory_gb": 32,
    "storage": "NVMe SSD recommended for the project and peak cache"
  },
  "scientific_invariants": {
    "training_batch_size": 16,
    "optimizer_steps": 30650,
    "training_views_per_structure": 2,
    "reason": "Preserve the registered optimizer-step, structure-exposure, spectrum-exposure, and matched-pair contracts across all methods."
  },
  "applied": {
    "evaluation_batch_size": 256,
    "dynamic_prefetch": {
      "applies_to_modes": [
        "clean_erm",
        "offline_erm",
        "dynamic_erm",
        "dynamic_js",
        "dynamic_residual"
      ],
      "worker_processes": 8,
      "worker_native_threads": 1,
      "prefetch_batches": 8,
      "multiprocessing_start_method": "spawn",
      "fixed_view_generation": "frozen-manifest-process-prefetch-v1",
      "clean_duplicate_policy": "render-once-reuse-x1-as-x2",
