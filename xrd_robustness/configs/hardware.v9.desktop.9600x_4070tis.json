    "current_selection": {
      "worker_processes": 8,
      "prefetch_batches": 8,
      "decision": "user-authorized eight-worker preference",
      "evidence_note": "Eight workers with an eight-batch window were consistently faster than eight workers with a six-batch window in matched 64- and 128-batch laptop audits, while preserving exact arrays and hashes.",
