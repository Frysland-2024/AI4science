    "independence_claim": "none; this minimal Pilot tests identifiability before adding physically grouped mechanisms"
  },
  "methodology_policy": {
    "parameter_source_hierarchy": [
      "peer_reviewed_literature",
      "paper_used_open_source_code",
      "physics_constrained_distribution",
      "explicitly_approved_real_instrument_data"
    ],
    "instrument_agnostic": true,
    "formal_training_requires_parameter_evidence": true
  },
  "real_experiment_policy": {
    "role": "optional_future_external_validation",
    "parameter_definition_source": false,
    "training_prerequisite": false
  },
  "parameter_evidence": {
    "background_type": {
      "code_source": "src/xrd_robustness/measurement_models.py",
      "physics_basis": "Disabled flat background is retained only to satisfy the common renderer contract."
    },
    "delta_2theta_deg": {
      "literature_source": ["Szymanski et al. 2021", "SimXRD-4M 2025"],
      "code_source": "src/xrd_robustness/simulator.py",
      "physics_basis": "One global 2theta-axis offset; the Pilot supervises the signed difference between paired views."
    },
    "fwhm_deg": {
      "literature_source": ["Salgado et al. 2023", "Schopmans et al. 2023"],
      "code_source": "src/xrd_robustness/simulator.py",
      "physics_basis": "Positive area-conserving effective Gaussian width; paired supervision uses the log-width ratio."
    },
    "background_to_peak_ratio": {
      "code_source": "src/xrd_robustness/measurement_models.py",
      "physics_basis": "Fixed at zero so background cannot confound the minimal identifiability Pilot."
    },
    "noise_std_ratio": {
      "code_source": "src/xrd_robustness/measurement_models.py",
      "physics_basis": "Fixed at zero so observation noise cannot confound the minimal identifiability Pilot."
    }
  },
