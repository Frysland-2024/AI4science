{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.xrd-robustness/schemas/simulation.v7.schema.json",
  "title": "XRD Robustness V7 Five-Perturbation Contract",
  "type": "object",
  "required": ["schema_version", "run_seed", "status", "methodology_policy", "real_experiment_policy", "parameter_evidence", "profiles"],
  "properties": {
    "schema_version": {"const": "v7.1-candidate"},
    "run_seed": {"type": "integer"},
    "purpose": {"type": "string"},
    "status": {"enum": ["candidate_not_frozen", "dev_3500_frozen", "formal_frozen"]},
    "apply_probability_semantics": {"type": "string", "minLength": 1},
    "normalization": {"type": "string"},
    "methodology_policy": {"type": "object"},
    "real_experiment_policy": {
      "type": "object",
      "required": ["role", "parameter_definition_source", "training_prerequisite"],
      "properties": {
        "role": {"const": "optional_future_external_validation"},
        "parameter_definition_source": {"const": false},
        "training_prerequisite": {"const": false}
      },
      "additionalProperties": false
    },
    "parameter_evidence": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/evidence_entry"}
    },
    "quality_gates": {"type": "object"},
    "profiles": {
      "type": "object",
      "minProperties": 3,
      "additionalProperties": {"$ref": "#/$defs/profile"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "source_value": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      ]
    },
    "evidence_entry": {
      "type": "object",
      "properties": {
        "literature_source": {"$ref": "#/$defs/source_value"},
        "code_source": {"$ref": "#/$defs/source_value"},
        "physics_basis": {"$ref": "#/$defs/source_value"}
      },
      "anyOf": [
        {"required": ["literature_source"]},
        {"required": ["code_source"]},
        {"required": ["physics_basis"]}
      ],
      "additionalProperties": false
    },
    "range": {
      "type": "object",
      "required": ["distribution", "min_value", "max_value", "apply_probability"],
      "properties": {
        "distribution": {"enum": ["fixed", "uniform", "log_uniform"]},
        "min_value": {"type": "number"},
        "max_value": {"type": "number"},
        "apply_probability": {"type": "number", "minimum": 0.0, "maximum": 1.0}
      },
      "additionalProperties": false
    },
    "preferred_orientation": {
      "type": "object",
      "required": ["enabled", "model", "distribution", "min_value", "max_value", "apply_probability"],
      "properties": {
        "enabled": {"type": "boolean"},
        "model": {"const": "march_dollase"},
        "distribution": {"enum": ["fixed", "uniform"]},
        "min_value": {"type": "number", "exclusiveMinimum": 0.0},
        "max_value": {"type": "number", "exclusiveMinimum": 0.0},
        "apply_probability": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "preferred_axis_policy": {"const": "low_index_reflection"},
        "candidate_low_index_count": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "required": ["severity_level", "background_type", "background_variation", "background_floor_fraction", "noise_model", "noise_stage", "poisson_count_scale", "electronic_noise_std_counts", "delta_2theta_deg", "fwhm_deg", "background_to_peak_ratio", "noise_std_ratio", "preferred_orientation"],
      "properties": {
        "severity_level": {"type": "integer", "minimum": 0, "maximum": 4},
        "background_type": {"enum": ["flat", "polynomial", "gaussian_process"]},
        "background_order": {"type": "integer", "minimum": 0, "maximum": 6},
        "background_variation": {
          "oneOf": [
            {"type": "number", "minimum": 0.0},
            {"$ref": "#/$defs/range"}
          ]
        },
        "background_anchor_count": {"type": "integer", "minimum": 8},
        "background_gp_length_scale": {"type": "number", "exclusiveMinimum": 0.0},
        "background_floor_fraction": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "noise_model": {"enum": ["additive_gaussian", "poisson", "poisson_gaussian"]},
        "noise_stage": {"enum": ["before_normalization", "after_normalization"]},
        "poisson_count_scale": {
          "oneOf": [
            {"type": "number", "exclusiveMinimum": 0.0},
            {"$ref": "#/$defs/range"}
          ]
        },
        "electronic_noise_std_ratio": {"type": "number", "minimum": 0.0},
        "electronic_noise_std_counts": {
          "oneOf": [
            {"type": "number", "minimum": 0.0},
            {"$ref": "#/$defs/range"}
          ]
        },
        "delta_2theta_deg": {"$ref": "#/$defs/range"},
        "fwhm_deg": {"$ref": "#/$defs/range"},
        "background_to_peak_ratio": {"$ref": "#/$defs/range"},
        "noise_std_ratio": {"$ref": "#/$defs/range"},
        "preferred_orientation": {"$ref": "#/$defs/preferred_orientation"}
      },
      "additionalProperties": false
    }
  }
}
