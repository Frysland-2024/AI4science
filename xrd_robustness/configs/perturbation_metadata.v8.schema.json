{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.xrd-robustness/schemas/perturbation_metadata.v8.schema.json",
  "title": "V8 Generated XRD View Metadata",
  "type": "object",
  "required": [
    "schema_version",
    "structure_id",
    "mother_pattern_id",
    "split",
    "epoch",
    "global_step",
    "view_id",
    "profile",
    "rng_seed",
    "strategy_name",
    "strategy_status",
    "measurement_state",
    "perturbation_parameters",
    "perturbation_activation",
    "generation_order",
    "config_hash",
    "code_version",
    "generated_at_utc"
  ],
  "properties": {
    "schema_version": {"const": "v8.0-interface"},
    "structure_id": {"type": "string", "minLength": 1},
    "mother_pattern_id": {"type": "string", "minLength": 1},
    "split": {"enum": ["train", "validation", "test"]},
    "epoch": {"type": "integer", "minimum": 0},
    "global_step": {"type": "integer", "minimum": 0},
    "view_id": {"type": "integer", "minimum": 0},
    "profile": {"type": "string", "minLength": 1},
    "rng_seed": {"type": "integer", "minimum": 0},
    "strategy_name": {"enum": ["independent_dynamic", "structured_dynamic"]},
    "strategy_status": {"type": "string", "minLength": 1},
    "measurement_state": {
      "type": "object",
      "required": ["sample_state", "instrument_state", "acquisition_state", "status"],
      "properties": {
        "sample_state": {"type": "object"},
        "instrument_state": {"type": "object"},
        "acquisition_state": {"type": "object"},
        "status": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "perturbation_parameters": {"type": "object", "minProperties": 1},
    "perturbation_activation": {
      "type": "object",
      "required": ["zero_shift", "peak_broadening", "preferred_orientation", "background", "noise"],
      "properties": {
        "zero_shift": {"type": "boolean"},
        "peak_broadening": {"type": "boolean"},
        "preferred_orientation": {"type": "boolean"},
        "background": {"type": "boolean"},
        "noise": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "generation_order": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "config_hash": {"type": "string", "minLength": 1},
    "code_version": {"type": "string", "minLength": 1},
    "generated_at_utc": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
