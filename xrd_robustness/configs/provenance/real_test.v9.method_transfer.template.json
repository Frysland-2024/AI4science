{
  "schema_version": "v9.1-method-transfer-real-test",
  "status": "awaiting_frozen_data_manifest",
  "enabled": false,
  "role": "final_external_test_only",
  "selection_use_forbidden": true,
  "data_manifest": {
    "path": "data/real_xrd/manifests/real_test_manifest.csv",
    "sha256": null,
    "required_columns": [
      "sample_id",
      "spectrum_path",
      "crystal_system",
      "source",
      "license_or_permission",
      "phase_purity_status",
      "label_evidence",
      "structure_identifier",
      "spectrum_sha256"
    ]
  },
  "preprocessing": {
    "two_theta_min": 10.0,
    "two_theta_max": 80.0,
    "step": 0.02,
    "interpolation": "linear",
    "out_of_range_fill": 0.0,
    "normalization": "max",
    "baseline_subtraction": "none",
    "smoothing": "none",
    "manual_peak_editing": false
  },
  "overlap_audit": {
    "required": true,
    "compare_against": [
      "material_id",
      "structure_fingerprint",
      "formula_and_space_group_when_exact_structure_is_unavailable"
    ],
    "training_overlap_policy": "report_and_exclude_from_primary_external_test",
    "validation_or_simulated_test_overlap_policy": "report_separately"
  },
  "unlock_requirements": [
    "unified Validation comparison selected and froze exactly one method",
    "selected checkpoint hashes are frozen",
    "simulated-test results are complete and immutable",
    "real-test data manifest and every spectrum hash are frozen",
    "preprocessing contract hash is frozen",
    "overlap audit passed",
    "explicit user authorization is recorded"
  ],
  "required_metrics": [
    "accuracy",
    "balanced_accuracy",
    "macro_f1",
    "per_class_recall",
    "per_class_f1",
    "confusion_matrix",
    "ece"
  ],
  "reporting": {
    "primary_population": "non_overlapping_real_test",
    "all_samples_reported": true,
    "confidence_intervals": "paired_or_stratified_bootstrap_95",
    "results_must_not_change_selected_method": true
  }
}
